[Unit]
Description=Gym Coach — push an alert to the phone that %i failed

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Projects/gym-coach
EnvironmentFile=%h/Documents/Projects/gym-coach/.env
ExecStart=%h/Documents/Projects/gym-coach/.venv/bin/python -m coach.notify \
    --title "Gym Coach: %i failed" \
    --message "A scheduled job failed on the server. Details: journalctl --user -u %i" \
    --priority 4 --tags warning
