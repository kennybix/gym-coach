[Unit]
Description=Gym Coach — (re)assert Tailscale serve on the dedicated node
After=network-online.target gym-coach-tailscaled.service coach-frontend.service
Wants=network-online.target
Requires=gym-coach-tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The dedicated tailscaled persists serve config across restarts; this re-asserts it.
# Maps https://gym-coach.<tailnet>.ts.net/ -> the gym frontend (:3010), which proxies the API.
# The node must be authed once: tailscale --socket=<sock> up --hostname=gym-coach
ExecStart=/bin/sh -c 'S=%h/.local/share/tailscale-gym-coach/tailscaled.sock; for i in 1 2 3 4 5 6; do /usr/bin/tailscale --socket="$S" status >/dev/null 2>&1 && break; sleep 5; done; /usr/bin/tailscale --socket="$S" serve --bg http://127.0.0.1:3010 || true'

[Install]
WantedBy=default.target
