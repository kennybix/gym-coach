[Unit]
Description=Gym Coach — weekly review batch (proactive coach)
# Best-effort dependency: the LLM proxy this app uses. Won't fail if absent.
Wants=cli-proxy.service
After=cli-proxy.service network-online.target coach-ntfy.service
# A genuine bug (not a model outage — those are deferred and alerted in-process) pings the phone.
OnFailure=coach-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Projects/gym-coach
EnvironmentFile=%h/Documents/Projects/gym-coach/.env
ExecStart=%h/Documents/Projects/gym-coach/.venv/bin/python -m coach.run_review --window-days 7 --if-missing
Nice=10
