[Unit]
Description=Gym Coach — weekly review batch (proactive coach)
# Best-effort dependency: the LLM proxy this app uses. Won't fail if absent.
Wants=cli-proxy.service
After=cli-proxy.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Projects/gym-coach
EnvironmentFile=%h/Documents/Projects/gym-coach/.env
ExecStart=%h/Documents/Projects/gym-coach/.venv/bin/python -m coach.run_review --window-days 7
# Reviews are advisory; one user's failure is logged but exit is non-zero so the
# timer surfaces problems via `systemctl --user status`.
Nice=10
