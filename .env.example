# --- database ---
COACH_DB_URI=postgresql://coach:coach@localhost/coachdb
COACH_SEED_DIR=./seed

# --- auth ---
# Secret used to sign + verify bearer tokens. Any strong secret; on Supabase, use the
# project's JWT secret. mint_token.py uses this to issue tokens.
SUPABASE_JWT_SECRET=change-me

# --- LLM (coach, review, RAG, judge) ---
# langchain-google-genai reads GOOGLE_API_KEY. Without it, the coach degrades to 503
# and logging keeps working.
GOOGLE_API_KEY=
# Model is provider-agnostic via init_chat_model; defaults below if unset.
COACH_MODEL=google_genai:gemini-3.5-flash
# Optional ranked failover chain (comma-separated provider:model). When set it replaces
# COACH_MODEL: each surface tries the models in order and skips any that are rate-limited.
COACH_MODELS=
COACH_RAG_MODEL=google_genai:gemini-3.5-flash
COACH_JUDGE_MODEL=google_genai:gemini-3.5-flash

# --- safety ---
# Region-appropriate, clinician-reviewed eating-disorder support resource shown with
# the coach's redirects. MUST be current and region-correct. Do NOT use a discontinued
# national line (e.g. the NEDA Helpline). Left blank = no resource string is shown.
COACH_SUPPORT_RESOURCE=

# --- frontend (web/) ---
# Set in the app's Setup tab at runtime (stored in the browser), not at build time:
#   API base URL  ->  http://localhost:8000
#   bearer token  ->  output of mint_token.py

# URL the app is served from — used to build the Android APK so it can reach the backend.
# With Tailscale Serve this is https://gym-coach.<your-tailnet>.ts.net
COACH_PUBLIC_URL=

# Optional push notifications via a self-hosted ntfy server (see deploy/NOTIFICATIONS.md).
# COACH_NTFY_URL is what the phone subscribes to; the backend can publish locally instead.
COACH_NTFY_URL=
COACH_NTFY_PUBLISH_URL=
# An unguessable topic name, e.g. gc-<22 random chars>
COACH_NTFY_TOPIC=
# app = taps open the Android app (gymcoach:// links); web = taps open the PWA
COACH_NOTIFY_LINKS=app
# Limit pushes to these account ids (comma-separated); empty = all accounts
COACH_NOTIFY_USERS=
